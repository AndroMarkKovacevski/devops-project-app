# =========================================================
#  PRIMJER konfiguracije za LOKALNI razvoj.
#  Kopiraj ovu datoteku u .env i po potrebi promijeni vrijednosti:
#      cp .env.example .env
#  .env se NE commita u git (vidi .gitignore) - sadrzi lokalne tajne.
# =========================================================

# --- PostgreSQL ---
POSTGRES_DB=ticketing
POSTGRES_USER=ticketing_user
POSTGRES_PASSWORD=change_me_local
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Aplikacija ---
API_PORT=8080
FRONTEND_PORT=3000
QUEUE_NAME=ticket_orders
NODE_ENV=development

# --- Frontend -> API ---
# VAZNO: browser radi na HOSTU (tvoje racunalo), ne unutar Docker mreze.
# Zato mora koristiti localhost + objavljeni port, a NE ime servisa "api".
# Servis-na-servis komunikacija (api -> postgres/redis) koristi imena servisa
# (POSTGRES_HOST=postgres, REDIS_HOST=redis) jer se odvija unutar Docker mreze.
API_BASE_URL=http://localhost:8080
