# syntax=docker/dockerfile:1
#
# API servis (Node.js / Express)
# Multi-stage build:
#   base         -> zajednicki sloj (radni dir + package.json za caching)
#   development  -> SVE ovisnosti (ukljucujuci nodemon) za hot-reload u lokalnom razvoju
#   prod-deps    -> samo runtime (produkcijske) ovisnosti
#   production   -> minimalna, non-root slika za produkciju (koristi se u 2. dijelu)

# Lokalni compose koristi target: development.


# ---------- base ----------
FROM node:20-alpine AS base
WORKDIR /app

COPY package.json ./


# ---------- development (hot-reload) ----------
FROM base AS development
ENV NODE_ENV=development

RUN npm install
COPY . .
USER node
EXPOSE 8080
CMD ["npm", "run", "dev"]

# ---------- prod-deps ----------
FROM base AS prod-deps
ENV NODE_ENV=production
RUN npm install --omit=dev

# ---------- production (minimalna, non-root) ----------
FROM node:20-alpine AS production
ENV NODE_ENV=production
WORKDIR /app
COPY --from=prod-deps /app/node_modules ./node_modules
COPY package.json ./
COPY src ./src
USER node
EXPOSE 8080
CMD ["npm", "start"]
